# Context hygiene for the claude-sandbox stage's COPY . /opt/claude-sandbox.
# The devcontainer build (target: developer) has no COPY, so this file
# does not change its behaviour.
.git
build
.venv*
tmp
node_modules
# Python package build output and dev caches (ADR 26). pyproject.toml and
# uv.lock are copied but inert in the image: nothing runs uv against them.
dist
__pycache__
.pytest_cache
.ruff_cache
